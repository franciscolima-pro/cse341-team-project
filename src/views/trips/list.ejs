<%- include('../partials/header') %>
<h1><%- title %></h1>

<div id="filters">
    <!-- 2-Filters: Let clients narrow results by the trip's exact region or best season. -->
    <label for="region-filter">Search by Region:</label>
    <select id="region-filter">
        <option value="all">All Regions</option>
    </select>

    <label for="season-filter">Search by Season:</label>
    <select id="season-filter">
        <option value="all">Any Season</option>
    </select>

    <!-- 2-Filters: Submit a keyword to search trip names and descriptions. -->
    <form id="trip-search-form" role="search">
        <label for="trip-search">Search trips:</label>
        <input
            type="search"
            id="trip-search"
            name="q"
            maxlength="100"
            placeholder="Search names or descriptions"
        >
        <button type="submit">Search</button>
    </form>
</div>

<div class="trains-state" id="trips-loading">Loading trips...</div>
<div class="trains-state trains-error" id="trips-error" hidden></div>
<div class="trains-state" id="trips-empty" hidden>No trips match these filters.</div>

<div class="routes-grid" id="trips-list"></div>
<!-- 1-Pagination: Provide previous/next controls and a live page-status label. -->
<nav class="trips-pagination" id="trips-pagination" aria-label="Trip list pages" hidden>
    <button type="button" id="trips-previous" aria-label="Previous page">Previous</button>
    <span id="trips-page-status" aria-live="polite"></span>
    <button type="button" id="trips-next" aria-label="Next page">Next</button>
</nav>

<template id="trip-card-template">
    <article class="route-card">
        <div class="route-header">
            <h2 class="route-name" data-field="name"></h2>
            <span class="route-region" data-field="region"></span>
        </div>

        <div class="station-info">
            <div class="station">
                <div class="station-type">From:</div>
                <div class="station-name" data-field="start-station"></div>
            </div>
            <div class="route-arrow">&#8594;</div>
            <div class="station">
                <div class="station-type">To:</div>
                <div class="station-name" data-field="end-station"></div>
            </div>
        </div>

        <div class="route-details">
            <div class="detail-item">
                <span class="detail-icon">&#128337;</span>
                <span><span class="detail-label">Duration:</span> <span data-field="duration"></span></span>
            </div>
            <div class="detail-item">
                <span class="detail-icon">&#128205;</span>
                <span><span class="detail-label">Distance:</span> <span data-field="distance"></span>km</span>
            </div>
            <div class="detail-item">
                <span class="season-badge" data-field="season">
                    Best in <span data-field="season-label"></span>
                </span>
            </div>
        </div>

        <div class="route-description" data-field="description"></div>

        <div class="highlights">
            <div class="highlights-list" data-field="highlights"></div>
        </div>

        <div class="route-actions">
            <a class="view-details-btn" data-field="details-link">
                View Details &amp; Book &#8594;
            </a>
        </div>
    </article>
</template>

<%- include('../partials/footer') %>